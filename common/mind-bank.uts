/**
 * 算算小达人 · 心情小课堂题库（1000 个情景 + 每个情景一条"怎么办"）
 *
 * 为什么是「场景族 × 20 个变体」，而不是 1000 条各写一遍：
 *  1. 4~5 岁学情绪靠"同一套办法反复用"，不靠 1000 种策略。同族共用一条解决办法，
 *     孩子看到第 3 个变体就能预判"这个办法我见过"，这才是学会，而不是每次都是新题。
 *  2. 变体只换对象（玩具 / 食物 / 声音 / 动作），句子结构不动，孩子不用重新理解情境。
 *  3. 体量可控：50 族 × 20 变体 = 1000 个具体场景，句子仍是手写的，不是拼出来的怪句。
 *
 * 硬要求：每条必须有 solve（接下来可以怎么做）。
 * 孩子选完心情之后，一定要听到"那我可以怎么办"——这是本模块的核心，不是附加项。
 *
 * 主题对应：P1 认识情绪 / P2 说出情绪 / P3 让自己平静 / P4 再试一次 / P5 我的身体 / P6 一次做一件事
 *
 * emoji 基线：Android 7 盒子 = Unicode 9，只能用 9.0 及以前的表情。
 *
 * 文案红线（静态检查会扫）：不贴标签、不宣称疗效、不出现"错"字、不用"失败"。
 */

/* ---------------- 场景族 ---------------- */

/**
 * 一个场景族：一句话模板 + 20 个可替换对象 + 一组选项 + 一条解决办法。
 * `scene` 里的 `{v}` 会被 `items` 逐个替换，生成 20 张具体卡片。
 */
export class MindFam {
	/** P1 ~ P6 */
	theme: string = ''
	/** 稳定键，只用于排查问题 */
	key: string = ''
	/** 大字图形 */
	face: string = ''
	/** 这张卡对应的心情（P1 是答案；其余主题用来给页面标心情） */
	mood: string = ''
	/** 情景模板，含 {v} */
	scene: string = ''
	/** 提问 */
	ask: string = ''
	/** 三个选项 */
	opts: Array<string> = []
	/** 首选答案 */
	answer: string = ''
	/** 再看看时的线索提示 */
	comfort: string = ''
	/** 答完之后的一句解释 */
	why: string = ''
	/** 怎么解决（必须可执行，说人话） */
	solve: string = ''
	/** 20 个替换对象 */
	items: Array<string> = []

	constructor(
		theme: string, key: string, face: string, mood: string,
		scene: string, ask: string, opts: Array<string>, answer: string,
		comfort: string, why: string, solve: string, items: Array<string>
	) {
		this.theme = theme
		this.key = key
		this.face = face
		this.mood = mood
		this.scene = scene
		this.ask = ask
		this.opts = opts
		this.answer = answer
		this.comfort = comfort
		this.why = why
		this.solve = solve
		this.items = items
	}
}

/** 构造一个场景族（少写 12 次 new） */
function fam(
	theme: string, key: string, face: string, mood: string,
	scene: string, ask: string, opts: Array<string>, answer: string,
	comfort: string, why: string, solve: string, items: Array<string>
): MindFam {
	return new MindFam(theme, key, face, mood, scene, ask, opts, answer, comfort, why, solve, items)
}

/** 把模板里的 {v} 换成具体对象（不用正则替换，各端行为更一致） */
export function fillItem(tpl: string, v: string): string {
	const key: string = '{v}'
	const i: number = tpl.indexOf(key)
	if (i < 0) return tpl
	return tpl.substring(0, i) + v + tpl.substring(i + key.length)
}

