/** 主题 → 中文名 */
export function enThemeName(theme: string): string {
	if (theme == 'T1') return '动物'
	if (theme == 'T2') return '食物'
	if (theme == 'T3') return '颜色'
	if (theme == 'T4') return '身体'
	if (theme == 'T5') return '家人'
	return '玩具'
}

/** 单元号（1~6）→ 主题 key */
export function enThemeOfUnit(unit: number): string {
	const i: number = unit < 1 ? 1 : (unit > 6 ? 6 : unit)
	return 'T' + i.toString()
}

/** 某单元的全部词（10 个） */
export function enWordsOfUnit(unit: number): Array<string> {
	const theme: string = enThemeOfUnit(unit)
	const out: Array<string> = []
	for (let i = 0; i < EN_WORDS.length; i++) {
		if (EN_WORDS[i].theme == theme) out.push(EN_WORDS[i].en)
	}
	return out
}

/** 按英文词取记录（找不到返回空对象：en.length == 0） */
export function enWordOf(en: string): EnWord {
	for (let i = 0; i < EN_WORDS.length; i++) {
		if (EN_WORDS[i].en == en) return EN_WORDS[i]
	}
	return new EnWord('', '', '', '', '', '', '')
}

/**
 * 首字母分组（首音感知题 EN3 用）
 *
 * 只有同组 ≥2 个词时才出这道题，否则"哪个和它开头一样"就变成了二选一。
 * 4 岁理解"开头"要举例，所以读题里会带上那个字母音。
 */
export function enFirstLetter(en: string): string {
	if (en.length == 0) return ''
	return en.substring(0, 1).toLowerCase()
}

/** 与 en 首字母相同的其他词（不含自己） */
export function enSameSound(en: string): Array<string> {
	const out: Array<string> = []
	const c: string = enFirstLetter(en)
	for (let i = 0; i < EN_WORDS.length; i++) {
		const w: EnWord = EN_WORDS[i]
		if (w.en != en && enFirstLetter(w.en) == c) out.push(w.en)
	}
	return out
}
