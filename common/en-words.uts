/**
 * 英语单词 · 词表（60 词 / 6 主题）
 *
 * 口径：4~5 岁只做"听懂 + 敢说"，**不做拼写、不做 CVC 拼读**（CEFR Pre-A1 不涉及书写；
 * 叽里呱啦把拼读放在 Y2 后半，斑马 S1~S2 只积累听力词汇）。方案见 `三科课程内容方案-v1.md`。
 *
 * 每条必须带的字段，一个都不能省：
 * - `ipa` + `near`（中文近似音）：电视 TTS 的引擎念英文常常很怪，家长听到不对会以为我们做坏了；
 *   而且家长要能跟着念，否则这科在客厅里没人陪。`near` 是给家长的，不给孩子看。
 * - `emoji` 或 `color`：题面靠图/色块，不靠插图资源，包体零增长。
 *
 * 颜色主题（T3）没有对应的 emoji 色块，所以用纯色 view 画点；`white` 在白底上会隐形，
 * 页面里给色点统一加了描边。
 */

export class EnWord {
	/** 英文词 */
	en: string = ''
	/** 中文意思 */
	zh: string = ''
	/** 音标 */
	ipa: string = ''
	/** 中文近似音（给家长念，不给孩子看） */
	near: string = ''
	/** 题面图（颜色主题为空） */
	emoji: string = ''
	/** 颜色主题的色值（其它主题为空） */
	color: string = ''
	/** 主题 T1~T6 */
	theme: string = ''

	constructor(en: string, zh: string, ipa: string, near: string, emoji: string, color: string, theme: string) {
		this.en = en
		this.zh = zh
		this.ipa = ipa
		this.near = near
		this.emoji = emoji
		this.color = color
		this.theme = theme
	}
}

