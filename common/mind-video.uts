/* ---------------- 查询 ---------------- */

/** 按 id 找短片（找不到返回第一条，页面不至于空白） */
export function videoOf(id: string): MindVideo {
	for (let i = 0; i < MIND_VIDEOS.length; i++) {
		if (MIND_VIDEOS[i].id == id) return MIND_VIDEOS[i]
	}
	return MIND_VIDEOS[0]
}

/** 某主题岛关联的短片（主题页将来做"看个短片"入口用） */
export function videosForTheme(themeId: string): Array<MindVideo> {
	const out: Array<MindVideo> = []
	for (let i = 0; i < MIND_VIDEOS.length; i++) {
		if (MIND_VIDEOS[i].theme == themeId) out.push(MIND_VIDEOS[i])
	}
	return out
}

/** 短片总数（首页文案用，避免写死"6 个"、改清单后不同步） */
export function videoCount(): number {
	return MIND_VIDEOS.length
}

/**
 * 单条失效时的兜底地址
 * 央视网改版会撤掉单条视频页，但栏目主页基本长期在；改投栏目页，家长还能自己找。
 */
export function fallbackOf(v: MindVideo): string {
	if (v.channelUrl.length > 0) return v.channelUrl
	return 'https://tv.cctv.com/cctv14/'
}

/** 「看完聊什么」的兜底（清单漏写时不要显示空白行） */
export function talkOf(v: MindVideo): string {
	if (v.talk.length > 0) return v.talk
	return '看完问一句：你最喜欢里面哪一段？'
}
