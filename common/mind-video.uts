/**
 * 算算小达人 · 心灵小剧场（心情小课堂的视频短片清单）
 *
 * 定位：给 4~5 岁看的「情绪 / 习惯 / 入园 / 轮流」类短片，全部来自央视少儿频道，
 * 只做**外链跳转播放**，不下载、不转码、不剪辑、不去水印。
 *
 * 三条硬约束（改清单前先看）：
 *  1. 只放央视官方页面（tv.cctv.com / cctv.com），不放二传、搬运、自媒体内容。
 *  2. 一条视频配一句「看完可以聊什么」——短片本身不是教育，聊那两句才是。
 *  3. 必须家长陪看：本模块所有播放入口都要过家长门（12+7），孩子单独点不开。
 *
 * 链接会失效。央视网改版时单条可能 404，所以每条都带 `channelUrl`（栏目主页）兜底，
 * 见 `fallbackOf()`；watch 页加载不出来时改投栏目主页，而不是让孩子对着白屏。
 */

/* ---------------- 数据结构 ---------------- */

/** 一条短片 */
export class MindVideo {
	/** 内部编号，如 V1 */
	id: string = ''
	/** 对应主题岛（P2 说出情绪 / P4 再试一次 / P6 一次做一件事） */
	theme: string = ''
	/** 卡片大图形 */
	emoji: string = ''
	/** 卡片标题（务必短，卡片一行放得下） */
	title: string = ''
	/** 来源标注，原样显示在卡片上 */
	source: string = ''
	/** 时长，如 01:26（取自央视网视频列表接口，不是估的） */
	duration: string = ''
	/** 看完可以聊什么（给家长的引导语，不朗读） */
	talk: string = ''
	/** 央视网视频详情页 */
	url: string = ''
	/** 同栏目主页，单条失效时改投这里 */
	channelUrl: string = ''
	/** 卡片配色档位 1~6，对应 cinema.uvue 里的 cv1~cv6（uvue 不能用动态渐变） */
	skin: number = 1
}

/** 栏目入口（小剧场底部的「去央视看更多」） */
export class VideoChannel {
	id: string = ''
	name: string = ''
	url: string = ''

	constructor(id: string, name: string, url: string) {
		this.id = id
		this.name = name
		this.url = url
	}
}

/** 构造一条短片（UTS 不允许对象字面量赋给 class，统一用工厂函数，与 mind.uts 的 card() 一致） */
function mv(
	id: string, theme: string, emoji: string, title: string, source: string,
	duration: string, talk: string, url: string, channelUrl: string, skin: number
): MindVideo {
	const v = new MindVideo()
	v.id = id
	v.theme = theme
	v.emoji = emoji
	v.title = title
	v.source = source
	v.duration = duration
	v.talk = talk
	v.url = url
	v.channelUrl = channelUrl
	v.skin = skin
	return v
}

/* ---------------- 栏目兜底 ---------------- */

export const VIDEO_CHANNELS: Array<VideoChannel> = [
	new VideoChannel('xxzhs', '小小智慧树', 'https://tv.cctv.com/lm/xxzhs/'),
	new VideoChannel('zhs', '智慧树', 'https://tv.cctv.com/lm/zhs/'),
	new VideoChannel('cctv14', '央视少儿频道', 'https://tv.cctv.com/cctv14/')
]

/* ---------------- 短片清单 ---------------- */

/**
 * 六条短片，2026-11-07 逐条实测可访问（HTTP 200）。
 *
 * 选片口径：单条 1~7 分钟（4~5 岁注意力上限约 8 分钟）、真人或玩偶、不依赖字幕、
 * 无广告口播、主题能接到心情模块已有的岛上。
 * 链接不要凭印象改：改完必须 `curl -o /dev/null -w "%{http_code}"` 验一遍。
 */
