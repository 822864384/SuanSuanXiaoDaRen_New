/** 主题 → 中文名（单元标题用） */
export function cnThemeName(theme: string): string {
	if (theme == 'T1') return '我自己'
	if (theme == 'T2') return '我的家'
	if (theme == 'T3') return '吃的'
	if (theme == 'T4') return '动物'
	if (theme == 'T5') return '自然'
	return '动作'
}

/** 单元号（1~6）→ 主题 key */
export function cnThemeOfUnit(unit: number): string {
	const i: number = unit < 1 ? 1 : (unit > 6 ? 6 : unit)
	return 'T' + i.toString()
}

/** 某单元的全部字（10 个） */
export function cnCharsOfUnit(unit: number): Array<string> {
	const theme: string = cnThemeOfUnit(unit)
	const out: Array<string> = []
	for (let i = 0; i < CN_WORDS.length; i++) {
		if (CN_WORDS[i].theme == theme) out.push(CN_WORDS[i].ch)
	}
	return out
}

/** 按字取记录（找不到返回空对象，调用方需判空：ch.length == 0） */
export function cnWordOf(ch: string): CnWord {
	for (let i = 0; i < CN_WORDS.length; i++) {
		if (CN_WORDS[i].ch == ch) return CN_WORDS[i]
	}
	return new CnWord('', '', '', '', [])
}

/**
 * 第 5 课用的"字卡小故事"（6 段 × 3 句）
 *
 * 关键约束：每句最多 1 个"大人念"的字（用 `|` 隔开标出来，页面上画成灰字）。
 * 为什么允许灰字：只用 10 个实词根本组不出句子（缺"有/的/在/了"这些虚词），
 * 洪恩的"子集绘本"能全用学过的字，是因为它一本书对应的是几百字的积累量。
 * 这里 10 个字配 1 个灰字，是 4 岁能读下去的最小可行结构。
 */
export class CnStory {
	/** 单元号 */
	unit: number = 1
	/** 3 句话，`|` 后的一段是"大人念"的字 */
	sentences: Array<string> = []

	constructor(unit: number, sentences: Array<string>) {
		this.unit = unit
		this.sentences = sentences
	}
}

export const CN_STORIES: Array<CnStory> = [
	new CnStory(1, ['我|(有)|大|手', '我|(有)|小|手', '大|手|小|手']),
	new CnStory(2, ['我|家|(有)|门', '爸|妈|(回)|家', '我|(的)|小|床']),
	new CnStory(3, ['我|(吃)|米|饭', '鱼|(和)|肉', '汤|甜|甜']),
	new CnStory(4, ['猫|(和)|狗', '小|鸡|小|鸭', '小|鸟|(飞)']),
	new CnStory(5, ['日|月|山|河', '花|草|树', '下|雨|(了)']),
	new CnStory(6, ['我|看|鸟|飞', '我|跑|我|走', '开|门|关|门'])
]

/** 某单元的故事（找不到返回空数组） */
export function cnStoryOf(unit: number): Array<string> {
	const u: number = unit < 1 ? 1 : (unit > 6 ? 6 : unit)
	for (let i = 0; i < CN_STORIES.length; i++) {
		if (CN_STORIES[i].unit == u) return CN_STORIES[i].sentences
	}
	return []
}
