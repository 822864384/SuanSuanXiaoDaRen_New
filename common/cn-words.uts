	new CnWord('高', '长高', '🦒', 'T20', ['亮', '京']),
	new CnWord('轻', '轻轻', '🪶', 'T20', ['经', '径']),
	new CnWord('重', '举重', '🏋️', 'T20', ['里', '董']),
	new CnWord('快', '飞快', '🏎', 'T20', ['块', '决']),
	new CnWord('慢', '慢慢', '🐌', 'T20', ['曼', '漫'])
]

/** 主题 → 中文名（单元标题用） */
export function cnThemeName(theme: string): string {
	if (theme == 'T1') return '我自己'
	if (theme == 'T2') return '我的家'
	if (theme == 'T3') return '吃的'
	if (theme == 'T4') return '动物'
	if (theme == 'T5') return '自然'
	if (theme == 'T6') return '动作'
	if (theme == 'T7') return '数字'
	if (theme == 'T8') return '颜色'
	if (theme == 'T9') return '好吃的'
	if (theme == 'T10') return '动物园'
	if (theme == 'T11') return '植物园'
	if (theme == 'T12') return '学本领'
	if (theme == 'T13') return '在路上'
	if (theme == 'T14') return '身体'
	if (theme == 'T15') return '家里用'
	if (theme == 'T16') return '穿的'
	if (theme == 'T17') return '玩一玩'
	if (theme == 'T18') return '大自然'
	if (theme == 'T19') return '会做事'
	return '比一比'
}

/** 单元号（1~20）→ 主题 key */
export function cnThemeOfUnit(unit: number): string {
	const i: number = unit < 1 ? 1 : (unit > 20 ? 20 : unit)
	return 'T' + i.toString()
}

/** 某单元的全部字（10 个） */
export function cnCharsOfUnit(unit: number): Array<string> {
	const theme: string = cnThemeOfUnit(unit)
	const out: Array<string> = []
	for (let i = 0; i < CN_WORDS.length; i++) {
		if (CN_WORDS[i].theme == theme) out.push(CN_WORDS[i].ch)
	}
	return out
}

/** 按字取记录（找不到返回空对象，调用方需判空：ch.length == 0） */
export function cnWordOf(ch: string): CnWord {
	for (let i = 0; i < CN_WORDS.length; i++) {
		if (CN_WORDS[i].ch == ch) return CN_WORDS[i]
	}
	return new CnWord('', '', '', '', [])
}

/**
 * 第 5 课用的"字卡小故事"（6 段 × 3 句）
 *
 * 关键约束：每句最多 1 个"大人念"的字（用 `|` 隔开标出来，页面上画成灰字）。
 * 为什么允许灰字：只用 10 个实词根本组不出句子（缺"有/的/在/了"这些虚词），
 * 洪恩的"子集绘本"能全用学过的字，是因为它一本书对应的是几百字的积累量。
 * 这里 10 个字配 1 个灰字，是 4 岁能读下去的最小可行结构。
 */
export class CnStory {
	/** 单元号 */
	unit: number = 1
	/** 3 句话，`|` 后的一段是"大人念"的字 */
	sentences: Array<string> = []

	constructor(unit: number, sentences: Array<string>) {
		this.unit = unit
		this.sentences = sentences
	}
}

export const CN_STORIES: Array<CnStory> = [
	new CnStory(1, ['我|(有)|大|手', '我|(有)|小|手', '大|手|小|手']),
	new CnStory(2, ['我|家|(有)|门', '爸|妈|(回)|家', '我|(的)|小|床']),
	new CnStory(3, ['我|(吃)|米|饭', '鱼|(和)|肉', '汤|甜|甜']),
	new CnStory(4, ['猫|(和)|狗', '小|鸡|小|鸭', '小|鸟|(飞)']),
	new CnStory(5, ['日|月|山|河', '花|草|树', '下|雨|(了)']),
	new CnStory(6, ['我|看|鸟|飞', '我|跑|我|走', '开|门|关|门']),
	new CnStory(7, ['一|二|三|四|五', '六|七|八|九|十', '七|上|八|下']),
	new CnStory(8, ['红|花|(和)|白|花', '白|云|下|(有)|红|日', '黑|猫|(和)|白|狗']),
	new CnStory(9, ['我|(吃)|甜|瓜', '大|桃|(和)|小|梨', '面|包|(加)|蛋']),
	new CnStory(10, ['小|蛇|(和)|小|蛙', '蜂|(和)|蝶|看|花', '小|龟|(和)|大|熊']),
	new CnStory(11, ['松|竹|(和)|枫|叶', '红|花|(和)|黄|菊', '山|上|(有)|绿|竹']),
	new CnStory(12, ['我|(在)|读|书', '我|(用)|笔|画|画', '我|听|歌|(和)|看|舞']),
	new CnStory(13, ['车|(过)|小|桥', '马|路|上|(有)|车', '我|(坐)|车|看|城']),
	new CnStory(14, ['手|掌|(和)|手|指', '我|(刷)|牙', '目|看|花|耳|听|歌']),
	new CnStory(15, ['我|(打)|开|伞', '锅|碗|(和)|杯|壶', '我|(坐)|椅|上']),
	new CnStory(16, ['红|裙|(和)|白|袜', '我|(穿)|鞋|走', '我|(穿)|衣']),
	new CnStory(17, ['我|玩|气|球', '我|(和)|娃|娃|玩', '拍|拍|手|抱|抱|娃']),
	new CnStory(18, ['鱼|(在)|大|洋', '我|看|星|星|(和)|月|月', '泉|水|(凉)']),
	new CnStory(19, ['我|坐|下|(吃)|饭', '洗|手|(再)|喝|汤', '我|拿|糖|(给)|妈|妈']),
	new CnStory(20, ['左|手|(和)|右|手', '车|(停)|门|前', '快|车|(和)|慢|车'])
]

/** 某单元的故事（找不到返回空数组） */
export function cnStoryOf(unit: number): Array<string> {
	const u: number = unit < 1 ? 1 : (unit > 20 ? 20 : unit)
	for (let i = 0; i < CN_STORIES.length; i++) {
		if (CN_STORIES[i].unit == u) return CN_STORIES[i].sentences
	}
	return []
}
