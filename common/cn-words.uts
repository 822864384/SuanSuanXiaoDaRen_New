/**
 * 语文识字 · 字表（200 字 / 20 主题，每主题 10 字 / 单元 5 课）
 *
 * 口径：4~5 岁（依据《3-6 岁儿童学习与发展指南》语言领域——4~5 岁**没有识字量指标**，
 * 且明确反对机械记忆和强化训练式的过早识字。所以只做"字 ↔ 图 ↔ 音"的联结与兴趣，
 * 不做拼音、不做笔顺、不做书写。方案见 `三科课程内容方案-v1.md`。
 *
 * 选字原则（改字表时请守住这四条，否则 4 岁认不动）：
 * 1. 独体字优先，笔画 ≤ 8 画（`你/他` 这种左右结构七八画的，4 岁认形很吃力）
 * 2. 生活高频：身体、家人、吃的、动物、自然、动作
 * 3. 每个字都能配一个 emoji（题面靠图，不靠插图资源，包体零增长）
 * 4. `word` 必须是孩子听过的 2 字词——读题用"苹果的果"，不用孤立的字音，
 *    因为孤立字音容易被多音字和 TTS 断句带偏
 *
 * `near` = 形近字，只用于听音找字/找字的干扰项。可以是本表外的字（形近优先于陌生），
 * 孩子在识字量少时干扰会自然弱化，学多了才真正生效——这是可接受的渐进难度，不是 bug。
 */

export class CnWord {
	/** 字 */
	ch: string = ''
	/** 组词（读题说"苹果的果"） */
	word: string = ''
	/** 题面图 */
	emoji: string = ''
	/** 主题 T1~T6 */
	theme: string = ''
	/** 形近字（干扰项用，可为空数组） */
	near: Array<string> = []

	constructor(ch: string, word: string, emoji: string, theme: string, near: Array<string>) {
		this.ch = ch
		this.word = word
		this.emoji = emoji
		this.theme = theme
		this.near = near
	}
}

