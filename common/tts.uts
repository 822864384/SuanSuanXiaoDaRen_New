/**
 * 算算小达人 · 朗读通道
 *
 * 产品硬需求：出题必须自动朗读（4~5 岁不识字），答错必须语音报出正确答案。
 *
 * 三级优先级（页面只调 speak()，不关心走哪一级）：
 *   ① 本地真人语音包 `static/voice/*.mp3`（`common/voice.uts`）——神经网络真人音色、带情绪
 *   ② 数学题干按题型模板拆片段拼接（同上，覆盖随机组合）
 *   ③ 系统 TTS 兜底：Web 用 speechSynthesis，App 用 `ssxdr-speech` UTS 插件
 *
 * 为什么要兜底而不是"全真人"：题目是随机生成的（数学题干组合上万种、心情 1000 个情景），
 * 不可能穷举录音。真人包覆盖高频固定内容，长尾交给 TTS，保证任何一句都有声音。
 *
 * ⚠️ UTS 插件不能在标准基座运行，必须打自定义基座才会出声；
 *    标准基座下 speak() 会捕获异常返回 false，页面据此不点亮"正在读题"。
 *    而真人语音包走的是 uni 内置 InnerAudioContext，**标准基座就能播**。
 */

// #ifdef APP-ANDROID
import {
  ttsSpeak, ttsStop, ttsWarmup
} from '@/uni_modules/ssxdr-speech'
// #endif
import { playVoiceText, isVoicePlaying, stopVoice, releaseVoice, setVoiceMissHandler } from './voice.uts'
import { OPTION_ORDS, PICK_ASK_LINE } from './voice-tpl.uts'

let speaking: boolean = false
/** App 端插件是否可用（第一次调用失败后置 false，避免每句都抛异常） */
let pluginBroken: boolean = false
/** 真人音频"断了"的接盘人是否已挂上（只挂一次） */
let missHooked: boolean = false

/**
 * 全端统一的朗读参数
 *
 * - 语速 0.82：0.62 是一开始按"4 岁跟不上"定的，实测偏慢——一句十来字要念四秒，
 *   孩子等不到重点就走神，家长也反馈"读得太磨"。0.82 约为成人正常语速的八成，
 *   既跟得上节奏，又比成人慢，字与字之间仍有停顿。
 * - 音调 1.22：抬高一点更亮、更像大姐姐说话；过高（>1.4）会失真发尖。
 * 语速越慢，estimateSpeakMs 的估算也要同步改，否则"正在读题"会提前熄灭。
 */
const SPEECH_RATE: number = 0.82
const SPEECH_PITCH: number = 1.22
/** 中文发音速度（字/秒），用于估算朗读时长：语速 0.82 实测约 4.0 字/秒 */
const CHARS_PER_SECOND: number = 4.0

/**
 * 语速倍率上限 / 下限（相对 SPEECH_RATE）
 *
 * 讲解类文案要"稍微快一点"（1.1 倍），读数时不能快成一片糊音；
 * 上限 1.2（≈ 正常成人语速的 98%），下限 0.7（更慢的安抚语气）。
 */
const SPEED_MIN: number = 0.7
const SPEED_MAX: number = 1.2

/**
 * 把"倍率"换算成引擎语速
 *
 * 页面只传 1.0 / 1.1 这种倍率，不直接碰 SPEECH_RATE——
 * 以后统一调基速时，所有倍率跟着一起变，不会出现某处还按老速度念。
 */
function rateOf(speed: number): number {
	let s: number = speed
	if (s < SPEED_MIN) s = SPEED_MIN
	if (s > SPEED_MAX) s = SPEED_MAX
	return SPEECH_RATE * s
}

/** 朗读中（页面用来点亮“正在说话”指示灯）；真人音频与系统 TTS 一起算 */
export function isSpeaking(): boolean {
  return speaking || isVoicePlaying()
}

/**
 * 当前平台是否具备朗读能力
 *
 * - Web / H5：浏览器 SpeechSynthesis 可用 → true
 * - App-Android：插件已内置 → true（引擎初始化是异步的，首句会在就绪后补读）
 * - 其它平台：false
 *
 * 页面据此决定「是否排队朗读」「再听一遍按钮显示什么」，不需要改页面代码。
 * 注意：这里只判断"平台有没有能力"，不判断"这一句有没有真的响"；
 * 真机上插件缺失时，speak() 返回 false，页面不会点亮"正在读题"，不会出现假提示。
 */
export function isTtsAvailable(): boolean {
  if (pluginBroken) return false
  let ok: boolean = false
  // #ifdef WEB
  // @ts-ignore
  ok = typeof window.speechSynthesis == 'object' && window.speechSynthesis != null
  // #endif
  // #ifdef APP-ANDROID
  ok = true
  // #endif
  return ok
}

/**
 * 预热朗读引擎（App 启动时调用，避免首题等初始化）
 * Web 端无需预热。
 */
export function warmupTts(): void {
  // #ifdef APP-ANDROID
  try {
    ttsWarmup()
  } catch (e) {
    pluginBroken = true
    console.log('[tts] 插件未就绪，请确认使用自定义基座')
  }
  // #endif
}

/**
 * 真人音频播到一半断了（mp3 坏、换 src 报错）时的接盘：剩下的文字交给系统 TTS 念完。
 *
 * 这一步是"题目不许没念完"的最后一道保险。以前遇到坏片段是直接跳过，
 * 家长听到的是"豆豆，我们来看看这张图。"然后就安静了——以为题干没拼上，其实是播放层断了。
 */
function onVoiceMiss(text: string): void {
  if (text.length == 0) return
  console.log('[tts] 补读：' + text)
  speakSystem(text, 'zh-CN')
}

function hookVoiceMiss(): void {
  if (missHooked) return
  missHooked = true
  setVoiceMissHandler(onVoiceMiss)
}

/**
 * 朗读一段文本
 * @param text 要读的文字（emoji 已在调用侧清理）
 * @param lang 语言，默认 zh-CN
 * @param speed 语速倍率（1.0 = 默认；1.1 略快，用于选完之后的解读）
 * @returns 是否已受理（false 表示这台设备上读不出来）
 */
export function speak(text: string, lang: string = 'zh-CN', speed: number = 1.0): boolean {
  if (text.length == 0) return false
  console.log('[tts] ' + text)
  // 先挂上"真人音频断了"的接盘人：只挂一次，之后每句都受保护
  hookVoiceMiss()

  // ① 真人语音包优先：整句命中或能按题型拆段-> 直接播本地 mp3
  //    这一步在 App 端走 InnerAudioContext，**标准基座也能出声**（不依赖 UTS 插件）
  //    注意不要在这里置 speaking：那是系统 TTS 的标志位，真人路径由 isVoicePlaying() 反映
  if (playVoiceText(text, speed)) {
    return true
  }
  return speakSystem(text, lang, speed)
}

/**
 * 只走系统 TTS（不经真人语音包）
 *
 * 两处调用：speak() 在语音包里找不到时兜底；真人音频播到一半断了时补读剩下的文字。
 * 单独拆出来是为了避免补读又绕回 playVoiceText（会自己调自己，死循环）。
 */
export function speakSystem(text: string, lang: string = 'zh-CN', speed: number = 1.0): boolean {
  if (text.length == 0) return false
  const rate: number = rateOf(speed)

  // #ifdef WEB
  try {
    // @ts-ignore
    const synth = window.speechSynthesis
    if (synth != null) {
      // 打断上一段，避免声音重叠
      synth.cancel()
      // @ts-ignore
      const u = new SpeechSynthesisUtterance(text)
      u.lang = lang
      u.rate = rate
      u.pitch = SPEECH_PITCH
      // 浏览器默认 voice 常常是"英文腔念中文"，或者是个低沉男声。
      // 按 lang 分流挑嗓音：中文题挑中文嗓音，英语跟读挑英文嗓音，再按音色打分。
      // @ts-ignore
      const voices = synth.getVoices()
      const wantEn: boolean = lang.indexOf('en') == 0
      // @ts-ignore
      let best: any = null
      let bestScore: number = 0
      for (let i = 0; i < voices.length; i++) {
        // @ts-ignore
        const v = voices[i]
        // @ts-ignore
        const l: string = v.lang
        const isZh: boolean = l.indexOf('zh') == 0 || l.indexOf('cmn') == 0
        const isEn: boolean = l.indexOf('en') == 0
        // 语言不匹配的一律跳过：否则会用中文嗓音念 apple，读音全歪
        if (wantEn && !isEn) continue
        if (!wantEn && !isZh) continue
        // @ts-ignore
        const n: string = (v.name as string).toLowerCase()
        let score: number = 10
        if (wantEn) {
          // 英文：优先童声/女声，美音加分（孩子将来听的多是美音）
          if (n.indexOf('child') >= 0 || n.indexOf('kid') >= 0) score += 8
          if (n.indexOf('female') >= 0 || n.indexOf('zira') >= 0 || n.indexOf('samantha') >= 0) score += 6
          if (l.indexOf('en-US') == 0) score += 3
          if (n.indexOf('male') >= 0) score -= 6
        } else {
          if (n.indexOf('xiaoxiao') >= 0 || n.indexOf('xiaoyi') >= 0) score += 8
          if (n.indexOf('huihui') >= 0 || n.indexOf('yaoyao') >= 0 || n.indexOf('ting-ting') >= 0) score += 6
          if (n.indexOf('child') >= 0 || n.indexOf('kid') >= 0) score += 6
          if (n.indexOf('female') >= 0) score += 4
          if (n.indexOf('male') >= 0) score -= 6
        }
        if (score > bestScore) {
          bestScore = score
          best = v
        }
      }
      if (best != null) u.voice = best
      u.onstart = () => {
        speaking = true
      }
      u.onend = () => {
        speaking = false
      }
      u.onerror = () => {
        speaking = false
      }
      synth.speak(u)
      return true
    }
  } catch (e) {
    console.log('[tts] web speak failed')
  }
  speaking = false
  return false
  // #endif

  // #ifdef APP-ANDROID
  if (pluginBroken) return false
  try {
    // lang 一并传下去：语文题 zh-CN，英语跟读 en-US，插件内部按需切语言
    const ok: boolean = ttsSpeak(text, rate, SPEECH_PITCH, lang)
    if (!ok) console.log('[tts] android 引擎未就绪或没有对应的语音包：' + lang)
    return ok
  } catch (e) {
    pluginBroken = true
    console.log('[tts] 插件调用失败：标准基座不含 UTS 插件，请改用自定义基座')
    return false
  }
  // #endif
}

/**
 * 解锁浏览器语音（H5 专用）
 *
 * Chrome 要求「页面有过用户手势」才允许 speechSynthesis 出声。
 * 从首页点进答题页已经算一次手势，一般无需额外处理；
 * 但直接刷新/深链进入答题页时首题可能被静默拦截，所以在每次点击后补一次 resume。
 */
export function unlockTts(): void {
  // #ifdef WEB
  try {
    // @ts-ignore
    const s = window.speechSynthesis
    if (s != null && s.paused) s.resume()
  } catch (e) {
    console.log('[tts] unlock failed')
  }
  // #endif
}

/** 立即停止朗读（切页 / 作答 / 离开结算页时调用） */
export function stopSpeak(): void {
  // 真人音频和系统 TTS 一起停：只停一边会出现"画面已经翻页，声音还在说上一句"
  stopVoice()
  // #ifdef WEB
  try {
    // @ts-ignore
    if (window.speechSynthesis != null) window.speechSynthesis.cancel()
  } catch (e) {
    console.log('[tts] web stop failed')
  }
  // #endif
  // #ifdef APP-ANDROID
  if (!pluginBroken) {
    try {
      ttsStop()
    } catch (e) {
      pluginBroken = true
    }
  }
  // #endif
  speaking = false
}

/**
 * 页面卸载时释放语音通道
 *
 * 真人音频用的是 InnerAudioContext，文档要求必须 destroy，否则多次进出页面会泄漏播放器实例。
 * 页面 onUnload 里除了 releaseSfx() 也要调这个。
 */
export function releaseSpeech(): void {
  stopSpeak()
  releaseVoice()
}

/** 去掉 emoji 与多余空格（TTS 读 emoji 会很怪） */
export function cleanForSpeech(text: string): string {
  let out: string = ''
  for (let i = 0; i < text.length; i++) {
    const ch: string = text.substring(i, i + 1)
    const code: number = text.charCodeAt(i)
    // emoji 的代理对（UTF-16 高位/低位）整段跳过
    if (code >= 0xd800 && code <= 0xdfff) continue
    // emoji 直显区 / 变体选择符 / 杂项符号
    if (code >= 0x1f000) continue
    if (code >= 0x2600 && code <= 0x27bf) continue
    if (code >= 0x2b00 && code <= 0x2bff) continue
    if (code >= 0xfe00 && code <= 0xfe0f) continue
    // 只去"豆腐块"占位符。**中文问号必须保留**：
    // 一是 TTS 靠它判疑问语气（去掉后"还剩几个呀"会读成陈述句），
    // 二是真人语音包的模板和 hash 都是按带标点的原文算的，删了会全部失配。
    if (ch == '□') continue
    out += ch
  }
  return out
}

/* ---------------- 读题文案 ---------------- */

/**
 * 出题朗读文案
 *
 * 4~5 岁听不懂"第 3 题请作答"这种书面语，但对"自己的名字 + 请听题"有即时反应
 * （叫名字先抓注意力，再说题目）。所以固定为「{名字}，请听题。{题干}」。
 *
 * @param name 当前档案的名字（豆豆）
 * @param prompt 题干（口语化，已在引擎里写好）
 */
export function questionSpeech(name: string, prompt: string): string {
  const body: string = prompt.trim()
  const who: string = name.trim()
  if (body.length == 0) return ''
  if (who.length == 0) return '小朋友，请听题。' + body
  return who + '，请听题。' + body
}

/** 重听文案：不再重复名字，避免孩子以为换人了 */
export function repeatSpeech(prompt: string): string {
  const body: string = prompt.trim()
  if (body.length == 0) return '再听一遍。'
  return '再听一遍。' + body
}

/* ---------------- 心情小课堂的读题文案 ---------------- */

/**
 * 心情卡朗读：不叫"请听题"
 *
 * 情绪模块要的是陪伴语气，不是考试语气。所以开场换成"我们来看看这张图"，
 * 情景先说完（句号处 TTS 会自然停顿），再提问。
 */
export function mindSpeech(name: string, scene: string, ask: string): string {
  const who: string = name.trim()
  const s: string = scene.trim()
  const a: string = ask.trim()
  const head: string = who.length == 0 ? '小朋友，我们来看看这张图。' : who + '，我们来看看这张图。'
  if (s.length == 0) return head + a
  return head + s + '。' + a
}

/** 心情卡重听：不重复名字 */
export function mindRepeatSpeech(scene: string, ask: string): string {
	const s: string = scene.trim()
	const a: string = ask.trim()
	if (s.length == 0) return '再看一遍。' + a
	return '再看一遍。' + s + '。' + a
}

/**
 * 心情卡的"怎么办"：解释 + 解决办法连成一句读
 *
 * 顺序不能反：先说"这是正常的"，再说"可以这样做"。
 * 孩子在情绪里的第一需求是被接纳，第二需求才是方法；先给方法会像在下指令。
 */
export function mindSolveSpeech(why: string, solve: string): string {
	const w: string = why.trim()
	const s: string = solve.trim()
	if (s.length == 0) return w
	if (w.length == 0) return '可以这样做。' + s
	return w + '。可以这样做。' + s
}

/* ---------------- 交往剧场的朗读文案 ---------------- */

/**
 * 剧集开场：先报"我们来看一个小故事"，再念第一帧旁白。
 * 不用"请听题"——交往剧场不是考试，是看故事。
 */
export function soOpenSpeech(name: string, first: string): string {
	const who: string = name.trim()
	const f: string = first.trim()
	const head: string = who.length == 0 ? '小朋友，我们来看一个小故事。' : who + '，我们来看一个小故事。'
	if (f.length == 0) return head
	return head + f + '。'
}

/**
 * 定格提问：直接叫名字再问，不带"请看图"这类废话。
 * 故事画面还在屏幕上，孩子知道在说哪一幕。
 */
export function soAskSpeech(name: string, ask: string): string {
	const who: string = name.trim()
	const a: string = ask.trim()
	if (a.length == 0) return ''
	if (who.length == 0) return '小朋友，' + a
	return who + '，' + a
}

/**
 * 估算朗读耗时（毫秒）
 * 中文按 4.0 字/秒（对齐语速 0.82），用于"正在读题"提示自动消隐与下一步排程。
 * 原生 TTS 暂无结束回调，只能按字数估；语速改了这里必须同步改，否则提示会提前熄灭。
 *
 * @param speed 与 speak() 的语速倍率一致：念得快，时长就按比例缩短
 */
export function estimateSpeakMs(text: string, speed: number = 1.0): number {
	const n: number = text.length
	if (n == 0) return 0
	let s: number = speed
	if (s < SPEED_MIN) s = SPEED_MIN
	if (s > SPEED_MAX) s = SPEED_MAX
	return Math.round(n * 1000 / (CHARS_PER_SECOND * s)) + 500
}

/* ---------------- 选项朗读文案 ---------------- */

/**
 * 读选项时先报"第几个"再读内容
 *
 * 为什么必须先报序号：4~5 岁不识字，他听到"坐好，先把饭吃完"时，
 * 目光还在屏幕上找不到对应那一格；听到"第二个"才会把视线挪过去。
 * 序号和选项高亮是同一个动作的两半，缺一个都不成立。
 *
 * ⚠️ 序号文案直接取自 voice-tpl.uts 的 OPTION_ORDS（语音包按同一份文案录音），
 * 差一个字、差一个逗号，这句就会整句退回系统 TTS——不要在这里另写一份。
 *
 * @param i 选项下标（从 0 开始）
 * @param text 选项原文（可能带 emoji，朗读前会被清洗掉）
 * @returns 朗读文案；这个选项没有任何可读文字（纯图/纯色块）时返回空串
 */
export function optionSpeech(i: number, text: string): string {
	const body: string = cleanForSpeech(text).trim()
	if (body.length == 0) return ''
	let head: string = ''
	if (i >= 0 && i < OPTION_ORDS.length) head = OPTION_ORDS[i]
	if (head.length == 0) return body
	return head + '，' + body
}

/** 选项读完之后的收尾问句：把决定权交回给孩子，不催（文案与语音包同一份） */
export function pickAskSpeech(): string {
	return PICK_ASK_LINE
}
