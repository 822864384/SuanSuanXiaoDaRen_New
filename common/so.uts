/* ---------------- 查询 ---------------- */

/** 类别下的全部剧集 */
export function episodesOf(themeId: string): Array<SoEpisode> {
	const out: Array<SoEpisode> = []
	for (let i = 0; i < SO_EPISODES.length; i++) {
		if (SO_EPISODES[i].theme == themeId) out.push(SO_EPISODES[i])
	}
	return out
}

/** 按 id 找类别（找不到返回第一个） */
export function soThemeOf(themeId: string): SoTheme {
	for (let i = 0; i < SO_THEMES.length; i++) {
		if (SO_THEMES[i].id == themeId) return SO_THEMES[i]
	}
	return SO_THEMES[0]
}

/** 按 id 找剧集（找不到返回第一集，页面不至于空白） */
export function episodeOf(id: string): SoEpisode {
	for (let i = 0; i < SO_EPISODES.length; i++) {
		if (SO_EPISODES[i].id == id) return SO_EPISODES[i]
	}
	return SO_EPISODES[0]
}

/** 某类别已演过几集 */
export function soProgressOf(themeId: string, doneIds: Array<string>): number {
	const pool: Array<SoEpisode> = episodesOf(themeId)
	let n: number = 0
	for (let i = 0; i < pool.length; i++) {
		if (doneIds.indexOf(pool[i].id) >= 0) n++
	}
	return n
}

/** 全部已演过多少集 */
export function soDoneCount(doneIds: Array<string>): number {
	let n: number = 0
	for (let i = 0; i < SO_EPISODES.length; i++) {
		if (doneIds.indexOf(SO_EPISODES[i].id) >= 0) n++
	}
	return n
}

/**
 * 下一集：优先没演过的，都演过了就从头来。
 * 不做随机组卷——交往剧集是"故事"，顺序看才连得上（同一句礼貌用语会在不同场景复现）。
 */
export function nextEpisode(themeId: string, doneIds: Array<string>): SoEpisode {
	const pool: Array<SoEpisode> = episodesOf(themeId)
	if (pool.length == 0) return SO_EPISODES[0]
	for (let i = 0; i < pool.length; i++) {
		if (doneIds.indexOf(pool[i].id) < 0) return pool[i]
	}
	return pool[0]
}

/* ---------------- 判定 ---------------- */

/**
 * 判定：只有 good / other 两种，没有"错"。
 * 页面拿到 other 时走「另一种结果 → 角色示范 → 跟读」，不是重来。
 */
export function judgeSo(opt: SoOption): string {
	return opt.good ? SO_GOOD : SO_OTHER
}

/** 好结局的一句夸奖（不夸张，社交场景要稳） */
export function soPraise(): string {
	return '这样做，别人心里会暖暖的'
}

/** 另一种结果的开场（不提"错"） */
export function soOtherOpen(): string {
	return '还有另一种样子'
}

/**
 * 交往之星称号：按已演集数算。
 * 设计文档 6.3：集满 7 颗给"社交小达人"。
 */
export function soTitleOf(stars: number): string {
	if (stars >= SO_BADGE_STARS) return '社交小达人'
	if (stars >= 4) return '会打招呼啦'
	if (stars >= 1) return '小小演员'
	return '新来的小演员'
}

/** 本集完成的一句话总结 */
export function soSummary(ep: SoEpisode, goodPick: boolean): string {
	if (goodPick) return '这一集你选得很好。记住这句话：' + ep.phrase + '。'
	return '这一集你看到了另一种样子。下次可以试试说：' + ep.phrase + '。'
}
