/**
 * 算算小达人 · 交往剧场（人际交往启蒙）数据与判定引擎
 *
 * 定位：不是答题，是「看一个小故事 → 停在要做决定的那一刻 → 选一个做法 → 看结果 → 跟说一句话」。
 * 与「🌈 心情小课堂」的边界：本模块管"对外怎么和别人相处"，心情课堂管"对内怎么安顿自己"。
 *
 * 四条硬约束（改文案前先看）：
 *  1. 没有"错误"这一档：选别的做法只是"另一种结果"，随后一定回到角色示范的正确做法。
 *     代码里只有 good / other 两种判定，文案里不出现"错"字。
 *  2. 不贴标签：不描述孩子（胆小/内向/多动…），只描述发生了什么。
 *  3. 结果要真实但不惩罚：另一种结果可以是"没人理你""妈妈着急"，但不能是羞辱或惊吓。
 *  4. 每集只教一句话：phrase 一集一句，跟读完就结束，不追加练习。
 *
 * 编号：S{类别}{集号}，如 S1-1 = 礼貌用语第 1 集。
 * 类别：S1 礼貌用语 / S2 分享合作 / S3 情绪管理（对别人）/ S4 安全意识。
 *
 * 素材说明：全部 emoji 分镜，无视频、无音频文件，包体积几乎为零；
 * emoji 限定在 Unicode 9 以内（Android 7 盒子能显示），新增条目前先查版本。
 */

/* ---------------- 判定 ---------------- */

/** 好做法 */
export const SO_GOOD: string = 'good'
/** 另一种做法（不判错，走"另一种结果 + 示范"） */
export const SO_OTHER: string = 'other'

/** 集满几颗交往之星给一个称号（设计文档 6.3：7 颗） */
export const SO_BADGE_STARS: number = 7

/* ---------------- 数据结构 ---------------- */

/** 一帧分镜：一个大图形 + 一句旁白 */
export class SoBeat {
	emoji: string = ''
	text: string = ''

	constructor(emoji: string, text: string) {
		this.emoji = emoji
		this.text = text
	}
}

/** 一个做法（选项） */
export class SoOption {
	text: string = ''
	/** 选它之后发生了什么（好结局 / 另一种结果） */
	after: string = ''
	good: boolean = false

	constructor(text: string, good: boolean, after: string) {
		this.text = text
		this.good = good
		this.after = after
	}
}

/** 一集 */
export class SoEpisode {
	id: string = ''
	/** 所属类别 S1~S4 */
	theme: string = ''
	title: string = ''
	/** 场景标签，顶栏显示（幼儿园门口 / 客厅…） */
	place: string = ''
	beats: Array<SoBeat> = []
	ask: string = ''
	options: Array<SoOption> = []
	/** 另一种结果之后，角色示范的正确做法（含动作 + 那句话） */
	demo: string = ''
	/** 跟读的一句话（≤ 7 字，孩子一口气能说完） */
	phrase: string = ''
	/** 这句话什么时候用 */
	phraseTip: string = ''
	/** 给家长的共聊话术（一集一句，屏幕下方小字） */
	parentTip: string = ''
}

/** 类别 */
export class SoTheme {
	id: string = ''
	emoji: string = ''
	name: string = ''
	sub: string = ''

	constructor(id: string, emoji: string, name: string, sub: string) {
		this.id = id
		this.emoji = emoji
		this.name = name
		this.sub = sub
	}
}

/* ---------------- 类别表 ---------------- */

export const SO_THEMES: Array<SoTheme> = [
	new SoTheme('S1', '👋', '礼貌用语', '问好 · 道谢 · 对不起'),
	new SoTheme('S2', '🤝', '分享合作', '一起玩 · 排队 · 帮忙'),
	new SoTheme('S3', '💬', '好好说话', '生气 · 输了 · 想要'),
	new SoTheme('S4', '🛡️', '安全保护', '陌生人 · 走散 · 插座')
]

/* ---------------- 分镜工具 ---------------- */

function beat(emoji: string, text: string): SoBeat {
	return new SoBeat(emoji, text)
}

function good(text: string, after: string): SoOption {
	return new SoOption(text, true, after)
}

function other(text: string, after: string): SoOption {
	return new SoOption(text, false, after)
}

/** 一集（参数多，用工厂函数收口，避免手写类字段时漏项） */
function ep(
	id: string, theme: string, title: string, place: string,
	beats: Array<SoBeat>, ask: string, options: Array<SoOption>,
	demo: string, phrase: string, phraseTip: string, parentTip: string
): SoEpisode {
	const e = new SoEpisode()
	e.id = id
	e.theme = theme
	e.title = title
	e.place = place
	e.beats = beats
	e.ask = ask
	e.options = options
	e.demo = demo
	e.phrase = phrase
	e.phraseTip = phraseTip
	e.parentTip = parentTip
	return e
}

/* ---------------- 全部剧集 ---------------- */

