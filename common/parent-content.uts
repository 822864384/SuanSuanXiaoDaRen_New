/* ---------------- 专题表 ---------------- */

function topic(
	id: string, emoji: string, title: string, sub: string, ready: boolean, blocks: Array<ParentBlock>
): ParentTopic {
	const t = new ParentTopic()
	t.id = id
	t.emoji = emoji
	t.title = title
	t.sub = sub
	t.ready = ready
	t.blocks = blocks
	return t
}

const NO_BLOCKS: Array<ParentBlock> = []

export const PARENT_TOPICS: Array<ParentTopic> = [
	topic('hw', '🌱', '写作业拖拉', '不盯着就不动，怎么建立自主习惯', true, HW_BLOCKS),
	topic('tantrum', '🌊', '发脾气、哭闹不止', '正在整理', false, NO_BLOCKS),
	topic('sep', '🎒', '分离焦虑与入园适应', '正在整理', false, NO_BLOCKS),
	topic('screen', '📱', '屏幕时间与睡前拉锯', '正在整理', false, NO_BLOCKS),
	topic('sibling', '👧', '争宠与同伴冲突', '正在整理', false, NO_BLOCKS)
]

/** 按 id 找专题（找不到返回第一个已开放的） */
export function topicOf(id: string): ParentTopic {
	for (let i = 0; i < PARENT_TOPICS.length; i++) {
		if (PARENT_TOPICS[i].id == id) return PARENT_TOPICS[i]
	}
	for (let i = 0; i < PARENT_TOPICS.length; i++) {
		if (PARENT_TOPICS[i].ready) return PARENT_TOPICS[i]
	}
	return PARENT_TOPICS[0]
}
