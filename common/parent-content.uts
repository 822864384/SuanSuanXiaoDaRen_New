/**
 * 算算小达人 · 家长课堂内容
 *
 * 面向成人阅读，与儿童端内容严格分开：
 * 这里可以出现"拖拉""磨蹭"这类描述行为（不是评价孩子）的词，
 * 儿童端（`mind.uts` / `pages/mind/*`）绝对不允许出现——见静态检查第 7 类。
 *
 * 每个专题固定四段结构：
 *   ① 先分清类型  ② 三个能马上用的做法  ③ 三句可以直接照念的话  ④ 一件千万别做的事
 * 好处是家长三分钟能拿走一个能用的动作，不需要读完一篇长文。
 *
 * 内容按块（block）切分，一次显示一屏——电视端没有触摸滚动，长页会被裁掉。
 */

export class ParentRow {
	a: string = ''
	b: string = ''

	constructor(a: string, b: string) {
		this.a = a
		this.b = b
	}
}

/** 一块内容 = 一屏 */
export class ParentBlock {
	/** 小标题（含 ①②③ 序号） */
	title: string = ''
	/** text 纯段落 / rows 两列条目 / items 编号列表 */
	kind: string = 'text'
	text: string = ''
	rows: Array<ParentRow> = []
	items: Array<string> = []
}

export class ParentTopic {
	id: string = ''
	emoji: string = ''
	title: string = ''
	sub: string = ''
	ready: boolean = false
	blocks: Array<ParentBlock> = []
}

function textBlock(title: string, text: string): ParentBlock {
	const b = new ParentBlock()
	b.kind = 'text'
	b.title = title
	b.text = text
	return b
}

function rowsBlock(title: string, rows: Array<ParentRow>): ParentBlock {
	const b = new ParentBlock()
	b.kind = 'rows'
	b.title = title
	b.rows = rows
	return b
}

function itemsBlock(title: string, items: Array<string>): ParentBlock {
	const b = new ParentBlock()
	b.kind = 'items'
	b.title = title
	b.items = items
	return b
}

/** 每个家长课堂页面底部都显示（免责声明，不可删） */
export const PARENT_DISCLAIMER: string =
	'本 App 提供的是家庭教育参考，不做诊断，也不能替代心理咨询或医疗。如果你担心孩子的状态，请直接找专业人员。'

/* ---------------- 专题 1：写作业拖拉 ---------------- */

