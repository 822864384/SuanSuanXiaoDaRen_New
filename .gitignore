# ---- uni-app x 编译产物 ----
# unpackage 是 HBuilderX / CLI 的构建输出（本地约 92MB），随时可重新生成
unpackage/
dist/

# ---- 依赖 ----
node_modules/

# ---- 编辑器 / 系统 ----
.hbuilderx/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ---- 测试 / 工具的中间产物 ----
tests/engine-tmp/
tools/engine-tmp/

# ---- 日志与临时文件 ----
*.log
*.tmp
~$*

# ---- 本地工作记录（Workspace Memory）----
# 里面是每日工作日志与项目记忆，属本机开发记录，不进仓库；
# 需要一并版本化时把下面这行删掉即可
.workbuddy/

# ---- 私人照片 ----
# 孩子真人照，属个人隐私，不进公开仓库；本地文件保留，
# 需要给某个角色挂照片时仍可用（头像值写 /static/photo.png）
static/photo.png
