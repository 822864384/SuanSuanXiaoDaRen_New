		border-color: rgba(255, 255, 255, 0.55);
	}

	/* 数字卡 */
	.ans-num {
		width: 74rpx;
		height: 70rpx;
	}

	/* 自评按钮 */
	.ans-self {
		width: 240rpx;
		height: 64rpx;
		background-color: rgba(62, 207, 142, 0.22);
	}

	.ans-self-text {
		color: #3ecf8e;
		font-size: 20rpx;
		font-weight: bold;
	}

	/* 底部两个小按钮 */
	.ans-say {
		width: 130rpx;
		height: 41rpx;
		background-color: rgba(255, 215, 110, 0.16);
	}

	.ans-say-text {
		color: #ffd76e;
		font-size: 12rpx;
	}

	/* ---------- 判定着色 ---------- */
	.ans-correct {
		background-color: #3ecf8e;
		border-color: #3ecf8e;
		transform: scale(1.06);
	}

	/* soft：暖橙不是红。红色＝危险/错误，这里只是"再看一眼" */
	.ans-soft {
		background-color: #ff9f43;
		border-color: #ff9f43;
	}

	.ans-dim {
		opacity: 0.45;
	}

	/*
	 * 正在朗读的那一格：读到哪儿亮到哪儿
	 *
	 * 和 `.ans-correct` 不会同时出现（选中即清读高亮），所以这里可以放心改底色 + 微放大。
	 * 用薄荷绿而不是金色：金色是"这个答案好"，绿是"我此刻在读它"，两种意思不能混。
	 */
	.ans-read {
		border-color: #3ecf8e;
		background-color: rgba(62, 207, 142, 0.26);
		transform: scale(1.05);
	}

	.ans-text-read {
		color: #eafff4;
		font-weight: bold;
	}

	/* ---------- 颜色（与 en-words.uts 的 T3 色值一一对应） ---------- */
	.c-red { background-color: #ff5c5c; }
	.c-yellow { background-color: #ffd76e; }
	.c-blue { background-color: #4a7bff; }
